generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  name        String
  email       String?
  phone       String?
  class_id    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        Role     @default(STUDENT)
  studentId   Int?     @unique
  student     Student? @relation(fields: [studentId], references: [id])
  assignments BchAssignment[]
  courses     Course[] @relation("TeacherCourses")
}

model Class {
  name               String              @id
  active_semester_id String?
  majorId            Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  students           Student[]
  attendanceSessions AttendanceSession[]
  activeSemester     Semester?           @relation("ActiveClass", fields: [active_semester_id], references: [name])
  availableSemesters Semester[]          @relation("SemesterScope")
  major              Major?              @relation(fields: [majorId], references: [id])

  @@index([active_semester_id])
  @@index([majorId])
}

model Student {
  id                Int                      @id @default(autoincrement())
  name              String
  student_code      String                   @unique
  email             String                   @unique
  class_id          String
  order_number      Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  attendances       Attendance[]
  attendanceProfile StudentAttendanceProfile?
  class             Class                    @relation(fields: [class_id], references: [name])
  trainingScores    TrainingScore[]
  evidenceSlips     TrainingEvidenceSlip[]
  activityRecords   ActivityAttendanceRecord[]
  grades            Grade[]
  registrations     CourseRegistration[]
  tuitions          Tuition[]
  assignmentSubmissions AssignmentSubmission[]
  examResults           ExamResult[]
  user              User?
  studentAwards     StudentAward[]
  activityEvidence  ActivityEvidence[]
  
  // Encrypted Sensitive Info
  birthday          String?
  gender            String?
  id_card           String?
  hometown          String?
  address           String?

  @@index([class_id])
  @@index([class_id, order_number])
}

model BchAssignment {
  id        Int      @id @default(autoincrement())
  bchUserId Int
  classId   String
  fromOrder Int
  toOrder   Int
  createdAt DateTime @default(now())
  bchUser   User     @relation(fields: [bchUserId], references: [id])

  @@index([bchUserId])
  @@index([classId, fromOrder, toOrder])
}

model Semester {
  name           String          @id
  startDate      DateTime?
  endDate        DateTime?
  isGlobal       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  trainingScores TrainingScore[]
  activeInClasses Class[]        @relation("ActiveClass")
  scopeClasses    Class[]        @relation("SemesterScope")

  @@index([isGlobal, startDate, endDate])
}

model TrainingScore {
  id              Int      @id @default(autoincrement())
  student_id      Int
  y_thuc          Int
  hoat_dong       Int
  ky_luat         Int
  total           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  details         Json?
  admin_details   Json?
  status          String   @default("APPROVED")
  admin_hoat_dong Int?
  admin_ky_luat   Int?
  admin_notes     String?
  admin_total     Int?
  admin_y_thuc    Int?
  semester_id     String
  semester        Semester @relation(fields: [semester_id], references: [name])
  student         Student  @relation(fields: [student_id], references: [id])

  @@unique([student_id, semester_id])
  @@index([status])
  @@index([semester_id])
  @@index([student_id, createdAt])
  @@index([semester_id, status])
}

model Attendance {
  id               Int                @id @default(autoincrement())
  student_id       Int
  date             DateTime           @default(now())
  status           String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deviceInfo       String?
  ipAddress        String?
  latitude         Float?
  longitude        Float?
  baselineCreated  Boolean            @default(false)
  verifiedIp       Boolean?
  verifiedLocation Boolean?
  profileDistance  Float?
  sessionDistance  Float?
  session_id       Int?
  session          AttendanceSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student          Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([student_id, date])
  @@index([session_id])
  @@index([session_id, student_id])
}

model AttendanceSession {
  id          Int          @id @default(autoincrement())
  title       String
  subject     String       @default("")
  class_id    String?
  qrToken     String       @unique
  lat         Float
  lng         Float
  radius      Float
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  endedAt     DateTime?
  sessionDate DateTime     @default(now())
  attendances Attendance[]
  class       Class?       @relation(fields: [class_id], references: [name], onDelete: Cascade)

  @@index([class_id, isActive])
  @@index([class_id, sessionDate])
  @@index([isActive, sessionDate])
}

model StudentAttendanceProfile {
  id                    Int      @id @default(autoincrement())
  student_id            Int      @unique
  firstIpAddress        String
  firstLatitude         Float
  firstLongitude        Float
  firstCheckInAt        DateTime @default(now())
  lastIpAddress         String?
  lastLatitude          Float?
  lastLongitude         Float?
  lastCheckInAt         DateTime?
  totalVerifiedCheckIns Int      @default(0)
  student               Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model ActivityAttendanceSession {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // e.g., "Hoạt động"
  points      Int
  qrToken     String   @unique
  sectionId   String?
  criterionId String?
  semesterId  String?
  classId     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  records     ActivityAttendanceRecord[]
}

model ActivityAttendanceRecord {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  studentId   Int
  points      Int      // Copied from session, but editable by admin
  scannedAt   DateTime @default(now())
  session     ActivityAttendanceSession @relation(fields: [sessionId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])
  
  @@unique([sessionId, studentId])
}

model TrainingEvidenceSlip {
  id          Int      @id @default(autoincrement())
  studentId   Int
  semesterId  String
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  manualData  Json?    // User entered points
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, semesterId])
}

enum Role {
  QTV
  LECTURER
  BCH
  STUDENT
}

model Room {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  capacity    Int?
  type        String?  @default("lecture") // lecture, lab, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  borrowings  RoomBorrowing[]
}

model Timetable {
  id          Int      @id @default(autoincrement())
  subject     String
  teacher     String
  room        String
  day         Int
  startPeriod Int
  endPeriod   Int
  classId     String
  semesterId  String
  type        String   @default("offline")
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId, semesterId])
  @@index([teacher])
  @@index([room, day])
}

model RoomBorrowing {
  id           Int      @id @default(autoincrement())
  roomId       Int
  roomName     String
  borrowerName String
  purpose      String
  date         DateTime
  startPeriod  Int
  endPeriod    Int
  status       String   @default("APPROVED") // APPROVED, RETURNED, CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room         Room     @relation(fields: [roomId], references: [id])

  @@index([date, roomName])
}
model Subject {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  credits        Int
  theoryPeriods  Int      @default(0)
  practicePeriods Int     @default(0)
  subjectType    String   @default("LECTURE") // LECTURE, PRACTICE, INTERNSHIP, THESIS
  pricePerCredit Float    @default(500000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  registrations  CourseRegistration[]
  classSubjects  ClassSubject[]
  curriculumAssignments CurriculumSubject[]
  requiredBy     CurriculumSubject[] @relation("Prerequisite")
  courses        Course[]
}

model Faculty {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  majors      Major[]
}

model Major {
  id             Int      @id @default(autoincrement())
  facultyId      Int
  code           String   @unique
  name           String
  totalCredits   Int      @default(161)
  totalSemesters Int      @default(13)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  faculty        Faculty  @relation(fields: [facultyId], references: [id])
  curriculumSemesters CurriculumSemester[]
  curriculumSubjects  CurriculumSubject[]
  classes             Class[]
}

model CurriculumSemester {
  id              Int      @id @default(autoincrement())
  majorId         Int
  semesterNumber  Int
  name            String
  expectedCredits Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  major           Major    @relation(fields: [majorId], references: [id])
  subjects        CurriculumSubject[]
}

model CurriculumSubject {
  id                   Int      @id @default(autoincrement())
  majorId              Int
  semesterId           Int      // Refers to CurriculumSemester
  subjectId            Int
  isRequired           Boolean  @default(true)
  prerequisiteSubjectId Int?
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  major                Major    @relation(fields: [majorId], references: [id])
  semester             CurriculumSemester @relation(fields: [semesterId], references: [id])
  subject              Subject  @relation(fields: [subjectId], references: [id])
  prerequisite         Subject? @relation("Prerequisite", fields: [prerequisiteSubjectId], references: [id])
}

model CourseRegistration {
  id         Int      @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  semesterId String
  status     String   @default("PENDING") // PENDING, APPROVED, CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, semesterId])
  @@index([studentId])
  @@index([semesterId])
}

model Tuition {
  id              Int       @id @default(autoincrement())
  studentId       Int
  semesterId      String
  totalAmount     Float
  paidAmount      Float     @default(0)
  remainingAmount Float     @default(0)
  status          String    @default("UNPAID") // UNPAID, PARTIAL_PAID, PAID
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@unique([studentId, semesterId])
  @@index([studentId])
  @@index([status])
}

model Payment {
  id                    Int          @id @default(autoincrement())
  studentId             Int
  tuitionId             Int
  paymentCode           String       @unique // Unique code for VNPay (vnp_TxnRef)
  amount                Float
  provider              String       @default("VNPAY")
  providerTransactionId String?      // vnp_TransactionNo
  status                String       @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED
  paymentUrl            String?      @db.Text
  paidAt                DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tuition               Tuition      @relation(fields: [tuitionId], references: [id])
  logs                  PaymentLog[]

  @@index([paymentCode])
  @@index([studentId])
  @@index([status])
}

model PaymentLog {
  id          Int      @id @default(autoincrement())
  paymentId   Int
  provider    String   @default("VNPAY")
  type        String   // RETURN or IPN
  payload     Json
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}
model Grade {
  id           Int      @id @default(autoincrement())
  studentId    Int
  subject      String
  semesterId   String
  processScore Float?   // Điểm quá trình
  midtermScore Float?   // Điểm giữa kỳ
  finalScore   Float?   // Điểm cuối kỳ
  totalScore   Float?   // Điểm tổng kết
  teacherId    Int?     // Giảng viên nhập điểm
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, semesterId])
  @@index([studentId])
  @@index([semesterId])
}

model ClassSubject {
  id         Int      @id @default(autoincrement())
  classId    String
  subjectId  Int
  semesterId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId, semesterId])
  @@index([classId])
  @@index([semesterId])
}
model SystemSetting {
  id                Int      @id @default(1)
  schoolName        String   @default("Trường Đại học Công nghệ")
  schoolAddress     String?
  activeSemester    String?
  registrationOpen  Boolean  @default(false)
  maintenanceMode   Boolean  @default(false)
  contactEmail      String?
  contactPhone      String?
  showGpa           Boolean  @default(true)
  allowEditPhone    Boolean  @default(true)
  allowEditAddress  Boolean  @default(true)
  showActivityPoints Boolean @default(true)
  updatedAt         DateTime @updatedAt
}

// --- E-LEARNING MODELS ---

model Course {
  id          Int      @id @default(autoincrement())
  subjectId   Int
  teacherId   Int
  semesterId  String
  classId     String?
  name        String
  description String?
  image       String?
  enrollKey   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  lessons     Lesson[]
  assignments Assignment[]
  exams       Exam[]

  @@index([teacherId])
  @@index([subjectId])
}

model Lesson {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  content     String?  @db.Text
  fileUrl     String?
  fileType    String?  // video, pdf, slide, link
  duration    String?  // e.g., "45:00" or "12 pages"
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  description String?  @db.Text
  fileUrl     String?
  dueDate     DateTime
  maxPoints   Int      @default(10)
  allowLate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  fileUrl      String
  content      String?  @db.Text
  grade        Float?
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Exam {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  duration    Int      // in minutes
  maxPoints   Int      @default(10)
  shuffle     Boolean  @default(false)
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   ExamQuestion[]
  results     ExamResult[]
}

model ExamQuestion {
  id          Int      @id @default(autoincrement())
  examId      Int
  question    String   @db.Text
  type        String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, ESSAY, TRUE_FALSE
  points      Float    @default(1)
  order       Int      @default(0)
  
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  options     ExamOption[]
}

model ExamOption {
  id          Int      @id @default(autoincrement())
  questionId  Int
  content     String   @db.Text
  isCorrect   Boolean  @default(false)
  
  question    ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamResult {
  id          Int      @id @default(autoincrement())
  examId      Int
  studentId   Int
  score       Float?
  status      String   @default("STARTED") // STARTED, SUBMITTED, GRADED
  answers     Json?    // Store student's answers
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?  @db.Text
  tag       String   // e.g., "Học vụ", "Đoàn Hội", "Tài chính"
  color     String   @default("blue") // blue, rose, amber, emerald
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentAward {
  id          Int      @id @default(autoincrement())
  studentId   Int
  title       String
  description String?  @db.Text
  type        String   @default("AWARD") // AWARD, TITLE
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model ActivityEvidence {
  id          Int      @id @default(autoincrement())
  studentId   Int
  title       String
  imageUrl    String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminTitle  String?
  points      Int?
  sectionId   String?
  criterionId String?
  semesterId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}
